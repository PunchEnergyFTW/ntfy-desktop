<Page x:Class="NtfyDesktop.Features.Feed.FeedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:converters="clr-namespace:NtfyDesktop.Features.Shell.Converters"
      xmlns:domain="clr-namespace:NtfyDesktop.Domain"
      xmlns:md="clr-namespace:NtfyDesktop.Features.Feed.Markdown"
      Background="Transparent"
      ScrollViewer.CanContentScroll="False"
      Title="Feed">

    <Page.Resources>
        <converters:PriorityToBrushConverter x:Key="PriorityBrush" />
        <converters:RelativeTimeConverter x:Key="RelTime" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <!-- Small icon button used for per-row actions on the feed (delete a single
             message). No chrome at rest, subtle background on hover. -->
        <Style x:Key="MessageRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ObjectDataProvider x:Key="Priorities"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="domain:Priority" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Page.Resources>

    <DockPanel LastChildFill="True" Background="Transparent">

        <Grid DockPanel.Dock="Top" Margin="32,20,32,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <ui:TextBlock FontTypography="TitleLarge" Text="{Binding Title}" />
                <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              FontTypography="Body"
                              Text="{Binding Subtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:ToggleSwitch Content="Show suppressed"
                                 IsChecked="{Binding ShowSuppressed, Mode=TwoWay}"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center" />
                <ui:Button Appearance="Secondary"
                           Content="Reconnect"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Margin="0,0,8,0"
                           Command="{Binding ReconnectCommand}"
                           Visibility="{Binding ShowReconnectButton, Converter={StaticResource BoolToVis}}" />
                <ui:Button Appearance="Secondary"
                           Content="Clear"
                           Icon="{ui:SymbolIcon Delete24}"
                           Command="{Binding ClearCommand}" />
            </StackPanel>
        </Grid>

        <Grid DockPanel.Dock="Top" Margin="32,0,32,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0"
                        PlaceholderText="Search title, body, tags"
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
            <ComboBox Grid.Column="1"
                      Margin="12,0,0,0"
                      ItemsSource="{Binding Source={StaticResource Priorities}}"
                      SelectedItem="{Binding MinPriority}" />
        </Grid>

        <Grid x:Name="MainFeedGrid" Margin="32,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Grid.RowSpan="2">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="380"
                        Margin="0,0,32,0"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <ui:SymbolIcon Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Symbol="Mail24"
                               FontSize="48"
                               Opacity="0.30"
                               HorizontalAlignment="Center" />
                <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Margin="0,12,0,4"
                              FontTypography="Subtitle"
                              HorizontalAlignment="Center"
                              Text="No notifications" />
                <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              FontTypography="Body"
                              HorizontalAlignment="Center"
                              TextAlignment="Center"
                              TextWrapping="Wrap"
                              Text="Nothing here yet. Messages arrive in real time once topics start sending." />
            </StackPanel>

            <ListBox x:Name="MessagesList"
                     ItemsSource="{Binding Messages}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,0,32,120"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Right margin keeps each row's right edge aligned with the
                             header/filter row above (which sits 32px from the window edge),
                             while the ListBox itself extends to the edge so the scrollbar
                             stays flush against the window. -->
                        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="0,14,0,14"
                                Margin="0,0,32,0"
                                Background="Transparent">
                            <!-- Background="Transparent" makes the whole row hit-test so the
                                 MouseBinding fires even on empty space between elements. -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasClick}" Value="True">
                                            <Setter Property="Cursor" Value="Hand" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <!-- Clicks on the Delete / Open-link buttons don't bubble to
                                     here (Button handles MouseLeftButtonDown internally), so
                                     this only fires for clicks on the body of the row. -->
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.OpenClickCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0"
                                         Width="8" Height="8"
                                         VerticalAlignment="Top"
                                         Margin="0,8,12,0"
                                         Fill="{Binding Priority, Converter={StaticResource PriorityBrush}}" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="3"
                                                Padding="6,1"
                                                Visibility="{Binding ShowTopic, Converter={StaticResource BoolToVis}}">
                                            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                          FontTypography="Caption"
                                                          Text="{Binding DisplayTopic}" />
                                        </Border>
                                        <!-- Server chip: only on the All-topics view with more than one
                                             server (HistoryMessage.ServerName is set accordingly). -->
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="3"
                                                Padding="6,1"
                                                Margin="6,0,0,0"
                                                Visibility="{Binding HasServer, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Server24" FontSize="11" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <ui:TextBlock Margin="4,0,0,0"
                                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                              FontTypography="Caption"
                                                              Text="{Binding ServerName}" />
                                            </StackPanel>
                                        </Border>
                                        <!-- Unrecognized tag labels rendered as compact chips next to the topic.
                                             Recognized tags (e.g. "warning") become emojis prepended to the
                                             title — see HistoryMessage.DisplayTitle. -->
                                        <ItemsControl ItemsSource="{Binding TagLabels}" Margin="6,0,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                            CornerRadius="3"
                                                            Padding="6,1"
                                                            Margin="0,0,4,0">
                                                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                      FontTypography="Caption"
                                                                      Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <ui:TextBlock FontTypography="BodyStrong"
                                                  Text="{Binding DisplayTitle}"
                                                  TextTrimming="CharacterEllipsis" />
                                    <!-- Message body. Plain text by default; rendered as a
                                         subset of Markdown (bold/italic/code/links/line
                                         breaks) only when ntfy flagged the message
                                         text/markdown. The StackPanel is filled in code-behind
                                         via the MarkdownBody attached properties. -->
                                    <StackPanel Margin="0,2,0,0"
                                                md:MarkdownBody.IsMarkdown="{Binding IsMarkdown}"
                                                md:MarkdownBody.Text="{Binding Body}" />

                                    <!-- Inline image attachment. A Button (not a Border+MouseBinding)
                                         so the click is consumed and doesn't also fire the row's
                                         OpenClick. DataContextChanged is the load trigger because the
                                         ListBox recycles containers without re-raising Loaded; the
                                         image service caches, so re-triggering on recycle is cheap. -->
                                    <Button Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Focusable="False"
                                            ToolTip="Open image"
                                            Visibility="{Binding HasImageAttachment, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="6"
                                                        ClipToBounds="True"
                                                        MaxWidth="360"
                                                        MaxHeight="240"
                                                        Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Image Source="{Binding AttachmentImage}"
                                               Stretch="Uniform"
                                               StretchDirection="DownOnly" />
                                    </Button>

                                    <!-- Non-image attachment: a compact chip that opens the file URL. -->
                                    <Button Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Cursor="Hand"
                                            Focusable="False"
                                            ToolTip="Open attachment"
                                            Visibility="{Binding HasFileAttachment, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="4"
                                                        Padding="8,4">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd"
                                                                Property="Background"
                                                                Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Attach24"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ui:TextBlock Margin="6,0,0,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                          FontTypography="Caption"
                                                          Text="{Binding AttachmentLabel}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Action buttons (ntfy "actions"). Each is a real Button so
                                         its click is consumed and doesn't also fire the row's
                                         OpenClick. The invoker enforces safety: view opens the URL,
                                         http confirms before firing, copy copies to clipboard.
                                         Unsupported actions (broadcast / no valid target) render
                                         disabled with an explanatory tooltip. -->
                                    <ItemsControl ItemsSource="{Binding Actions}"
                                                  Margin="0,8,0,0"
                                                  Visibility="{Binding HasActions, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:Button Appearance="Secondary"
                                                           Margin="0,0,8,0"
                                                           Padding="10,4"
                                                           Content="{Binding Label}"
                                                           IsEnabled="{Binding IsSupported}"
                                                           ToolTip="{Binding DisabledReason}"
                                                           ToolTipService.ShowOnDisabled="True"
                                                           Command="{Binding DataContext.InvokeActionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Top"
                                            Margin="16,0,0,0">
                                    <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  FontTypography="Caption"
                                                  Text="{Binding Timestamp, Converter={StaticResource RelTime}}"
                                                  VerticalAlignment="Center" />
                                    <!-- Open-link icon: only shown when the message has a
                                         safe (http/https) click URL. Stops the row-level
                                         MouseBinding from firing twice by being a Button. -->
                                    <Button Style="{StaticResource MessageRowButton}"
                                            Margin="8,0,0,0"
                                            ToolTip="Open link"
                                            Visibility="{Binding HasClick, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.OpenClickCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Open24" FontSize="14" />
                                    </Button>
                                    <!-- Always visible so users discover it; muted at rest,
                                         brightens on hover via the button's own template. -->
                                    <Button Style="{StaticResource MessageRowButton}"
                                            Margin="8,0,0,0"
                                            ToolTip="Delete this message"
                                            Command="{Binding DataContext.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Grid>

            <!-- Chat Compose Card at the bottom -->
            <Border x:Name="ComposeCardBorder"
                    Grid.Row="1"
                    Margin="0,16,32,16"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    MaxHeight="{Binding ElementName=MainFeedGrid, Path=ActualHeight}"
                    Visibility="{Binding IsTopicSelected, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="MaxWidth" Value="320" />
                    </Style>
                </Border.Style>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Error banner -->
                        <RowDefinition Height="Auto" /> <!-- Options panel -->
                        <RowDefinition Height="Auto" /> <!-- Body / Preview -->
                        <RowDefinition Height="Auto" /> <!-- Toolbar -->
                    </Grid.RowDefinitions>

                    <!-- Error Banner -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                            BorderBrush="{DynamicResource SystemStrokeColorCriticalBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6"
                            Margin="0,0,0,8"
                            Visibility="{Binding IsPublishErrorVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="ErrorCircle24"
                                           Foreground="{DynamicResource SystemStrokeColorCriticalBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                            <ui:TextBlock Grid.Column="1"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          VerticalAlignment="Center"
                                          Text="{Binding PublishError}"
                                          TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <!-- Options Panel -->
                    <Border Grid.Row="1"
                            x:Name="OptionsPanel"
                            Height="0"
                            ClipToBounds="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPublishExpanded}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Height"
                                                                     To="150" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <PowerEase Power="3" EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Height"
                                                                     To="0" Duration="0:0:0.2">
                                                        <DoubleAnimation.EasingFunction>
                                                            <PowerEase Power="3" EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Title & Priority -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            PlaceholderText="Title (optional)"
                                            Text="{Binding ComposeTitle, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding IsPublishing, Converter={StaticResource InverseBoolToVis}}" />
                                <ComboBox Grid.Column="1"
                                          Margin="12,0,0,0"
                                          ItemsSource="{Binding Source={StaticResource Priorities}}"
                                          SelectedItem="{Binding ComposePriority, Mode=TwoWay}"
                                          IsEnabled="{Binding IsPublishing, Converter={StaticResource InverseBoolToVis}}" />
                            </Grid>

                            <!-- Tags & Click URL -->
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            PlaceholderText="Tags (e.g. warning, skull)"
                                            Text="{Binding ComposeTags, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding IsPublishing, Converter={StaticResource InverseBoolToVis}}" />
                                <ui:TextBox Grid.Column="1"
                                            Margin="12,0,0,0"
                                            PlaceholderText="Click URL (optional)"
                                            Text="{Binding ComposeClickUrl, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding IsPublishing, Converter={StaticResource InverseBoolToVis}}" />
                            </Grid>

                            <!-- Markdown options -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                <ui:ToggleSwitch Content="Markdown formatting"
                                                 IsChecked="{Binding ComposeIsMarkdown, Mode=TwoWay}"
                                                 IsEnabled="{Binding IsPublishing, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Body / Preview -->
                    <Grid Grid.Row="2">
                        <!-- Write Editor -->
                        <ui:TextBox x:Name="MessageInput"
                                    Text="{Binding ComposeBody, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Send a message..."
                                    AcceptsReturn="True"
                                    AcceptsTab="True"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto"
                                    IsEnabled="{Binding IsPublishing, Converter={StaticResource InverseBoolToVis}}"
                                    Visibility="{Binding IsPreviewMode, Converter={StaticResource InverseBoolToVis}}">
                            <ui:TextBox.Style>
                                <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
                                    <Setter Property="MinHeight" Value="36" />
                                    <Setter Property="MaxHeight" Value="36" />
                                </Style>
                            </ui:TextBox.Style>
                        </ui:TextBox>

                        <!-- Preview Panel -->
                        <Border Padding="10,6"
                                Background="Transparent"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{Binding IsPreviewMode, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="MinHeight" Value="56" />
                                    <Setter Property="MaxHeight" Value="120" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPublishExpanded}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="MinHeight"
                                                                         To="100" Duration="0:0:0.30">
                                                            <DoubleAnimation.EasingFunction>
                                                                <PowerEase Power="3" EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                         To="300" Duration="0:0:0.30">
                                                            <DoubleAnimation.EasingFunction>
                                                                <PowerEase Power="3" EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="MinHeight"
                                                                         To="56" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <PowerEase Power="3" EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                         To="120" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <PowerEase Power="3" EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel md:MarkdownBody.Text="{Binding ComposeBody}"
                                            md:MarkdownBody.IsMarkdown="True" />
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Toolbar -->
                    <Grid Grid.Row="3">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Margin" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsKeyboardFocusWithin, ElementName=ComposeCardBorder}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Margin" Value="0,8,0,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPublishExpanded}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Margin" Value="0,8,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Action Group -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <!-- Collapse Button -->
                            <ui:Button Appearance="Transparent"
                                       Padding="6"
                                       Margin="0,0,4,0"
                                       ToolTip="Collapse input"
                                       Click="CollapseButton_Click"
                                       IsEnabled="{Binding IsPublishing, Converter={StaticResource InverseBoolToVis}}">
                                <ui:SymbolIcon Symbol="ChevronDown24" />
                            </ui:Button>

                            <!-- Toggle Options -->
                            <ui:Button Appearance="Transparent"
                                       Padding="6"
                                       ToolTip="Options (Title, Priority, Tags...)"
                                       Command="{Binding TogglePublishExpandedCommand}"
                                       IsEnabled="{Binding IsPublishing, Converter={StaticResource InverseBoolToVis}}">
                                <ui:SymbolIcon Symbol="Edit24" />
                            </ui:Button>
                        </StackPanel>

                        <!-- Preview Toggle -->
                        <ui:ToggleSwitch Grid.Column="1"
                                         Content="Preview"
                                         IsChecked="{Binding IsPreviewMode, Mode=TwoWay}"
                                         Visibility="{Binding ComposeIsMarkdown, Converter={StaticResource BoolToVis}}"
                                         IsEnabled="{Binding IsPublishing, Converter={StaticResource InverseBoolToVis}}"
                                         Margin="8,0,0,0"
                                         VerticalAlignment="Center" />

                        <!-- Sending Indicator -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0"
                                    Visibility="{Binding IsPublishing, Converter={StaticResource BoolToVis}}">
                            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" />
                            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Sending..." />
                        </StackPanel>

                        <!-- Send Button -->
                        <ui:Button Grid.Column="3"
                                   Appearance="Primary"
                                   Content="Send"
                                   Icon="{ui:SymbolIcon Send24}"
                                   Command="{Binding SendMessageCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Page>
